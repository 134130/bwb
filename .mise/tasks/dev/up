#!/bin/sh
#MISE description="Prepare a persistent development vault from the integration snapshot"
set -eu
cd "$MISE_PROJECT_ROOT"
if [ ! -x .dev/venv/bin/python ]; then
    python3 -m venv .dev/venv
fi
.dev/venv/bin/python -m pip install -r dev/integration/requirements.txt
exec .dev/venv/bin/python dev/integration/demo.py up
